-		if (strcmp(udev_list_entry_get_name(entry), key) == 0)
-			return udev_list_entry_get_value(entry);
-
-	return NULL;
+	if (hwdb)
+		udev_list_entry_foreach(entry, udev_hwdb_get_properties_list_entry(hwdb, modalias, 0))
+			if (strcmp(udev_list_entry_get_name(entry), key) == 0)
+				return udev_list_entry_get_value(entry);
+#endif
+	return ids_lookup(modalias, key);
 }
 
